# ==============================================================================
# GROUPIN ACCOUNT CHECKER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# Never commit .env with real secrets to version control!
# ==============================================================================

# Groupin Contacts & Account Verification API Configuration
CONTACTS_CHECK_URL=https://api.groupin.app/api/v1/contacts/check-registered
CONTACTS_API_KEY=your_contacts_api_key_here

# Batching & Rate Limiting Controls
GROUPIN_BATCH_SIZE=500
GROUPIN_MAX_RETRIES=3
GROUPIN_REQUEST_DELAY_MS=100
GROUPIN_REQUEST_TIMEOUT=30

# Toggle Mock Adapter (false = real live API, true = simulation)
USE_MOCK_GROUPIN=false

# Authentication & JWT Secrets
JWT_SECRET_KEY=generate_a_secure_random_64_character_hex_string_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Dashboard Credentials
ADMIN_USERNAME=admin@company.com
ADMIN_PASSWORD=your_secure_password_here

# Database Configuration
DATABASE_URL=sqlite:///./groupin.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/groupin_verify

# Redis Queue Configuration (Optional)
REDIS_URL=redis://localhost:6379/0

# Groups SaaS MessageBot API Configuration
GROUPS_API_URL=https://api.groupin.app/api/v1
GROUPS_API_KEY=your_groups_api_key_here

# File Upload Limits
MAX_UPLOAD_SIZE_MB=100
