GROUPIN_API_URL=https://api.groupin.com/v1
GROUPIN_API_KEY=your_groupin_api_key_here
GROUPIN_BATCH_SIZE=50
GROUPIN_MAX_RETRIES=3
GROUPIN_REQUEST_DELAY_MS=150
GROUPIN_REQUEST_TIMEOUT=30
USE_MOCK_GROUPIN=true

# Database: PostgreSQL or local SQLite fallback
DATABASE_URL=sqlite:///./groupin.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/groupin_verify

REDIS_URL=redis://localhost:6379/0

# Groups SaaS MessageBot API Configuration
GROUPS_API_URL=https://stag-saas-messagebot.tech-v2.groupin.app
GROUPS_API_KEY=your_groups_api_key_here

MAX_UPLOAD_SIZE_MB=100

