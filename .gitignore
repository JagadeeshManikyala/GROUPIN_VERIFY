# ==============================================================================
# GROUPIN ACCOUNT CHECKER — REPOSITORY ROOT GITIGNORE
# Consolidates all rules for Root, Backend (Python/FastAPI), and Frontend (React/Vite)
# ==============================================================================

# Environment variables and secrets
.env
backend/.env
*.env
.env.*
!.env.example
!backend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
venv/
ENV/
env/
.pytest_cache/

# Database & SQLite
*.db
*.sqlite
*.sqlite3
backend/groupin.db

# Storage, Uploads, Results, Data
backend/uploads/*
!backend/uploads/.gitkeep
backend/results/*
!backend/results/.gitkeep
backend/data/
data/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
